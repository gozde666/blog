<%# Modeldeki hataları gösteren bölüm %>
<% if @post.errors.any? %>
  <div style="background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
    <h3 style="margin-top: 0;"><%= @post.errors.count %> hata bulundu:</h3>
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div style="margin-bottom: 15px;">
  <%= form.label :title, "Yazı Başlığı" %><br>
  <%= form.text_field :title, style: "width: 100%; padding: 8px;" %>
</div>

<div style="margin-bottom: 15px;">
  <%= form.label :body, "İçerik" %><br>
  <%= form.text_area :body, rows: 5, style: "width: 100%; padding: 8px;" %>
</div>

<div style="margin-bottom: 15px;">
  <%= form.label :author, "Yazar" %><br>
  <%= form.text_field :author, style: "width: 100%; padding: 8px;" %>
</div>

<%= form.submit "Kaydet", style: "background-color: #28a745; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 5px;" %>