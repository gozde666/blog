<div class="position-relative">
  <div class="text-center py-5" style="background: linear-gradient(135deg, #1a0033 0%, #0d0019 100%); min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div>
      <h1 class="display-2 fw-bold text-neon-purple mb-3">Blog'a Hoş Geldiniz</h1>
      <p class="lead text-white opacity-75 mb-5">Düşüncelerini paylaş, yazılarını keşfet.</p>
      <% path = user_signed_in? ? new_user_post_path(current_user) : new_user_session_path %>
      <%= link_to "Yazmaya Başla", path, class: "btn btn-neon-purple btn-lg rounded-pill px-5 py-3 shadow" %>
    </div>
  </div>
</div>