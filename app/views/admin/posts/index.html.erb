<div class="container mt-4">
  <h1 class="fw-bold text-neon-purple mb-4">Tum Blog Kayitlari</h1>
  <div class="card purple-card p-3">
    <table class="table table-dark table-hover">
      <thead>
        <tr>
          <th>Yazar</th>
          <th>Baslik</th>
          <th>Olusturulma Tarihi</th>
          <th>Durum</th>
          <th>Islem</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <td><%= post.user.fullname %></td>
            <td><%= post.title %></td>
            <td><%= post.created_at.strftime("%d.%m.%Y %H:%M") %></td>
            <td><span class="badge bg-primary">active</span></td>
            <td><%= link_to "Goruntule", admin_post_path(post), class: "btn btn-outline-light btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>