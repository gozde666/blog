<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-5">
    <h1 class="fw-bold text-neon-purple display-4">Blog Yazılarım</h1>
    <%= link_to "+ Yeni Yazı Ekle", "/new", class: "btn btn-neon-purple px-4 py-2 rounded-pill shadow" %>
  </div>

  <div class="posts-container">
    <% @posts.each do |post| %>
      <div class="card purple-card mb-4">
        <div class="card-body p-4 text-white">
          
          <h2 class="card-title">
            <a href="/post/<%= post.id %>" class="text-white text-decoration-none fw-bold">
              <%= post.title %>
            </a>
          </h2>
          
          <p class="opacity-75"><%= post.body %></p>
          <hr class="border-light opacity-25">

          <div class="d-flex justify-content-between align-items-center">
            <p class="mb-0 small opacity-75">
              <strong>Yazar:</strong> <span class="text-info"><%= post.author %></span>
            </p>
            
            <div class="d-flex align-items-center gap-3">
              <a href="/edit/<%= post.id %>" class="text-info text-decoration-none small fw-bold">Düzenle</a>

              <%= button_to "Bu Yazıyı Sil", "/delete/#{post.id}",
                method: :delete,
                data: { confirm: "Emin misin?" },
                class: "btn btn-light-pink btn-sm rounded-pill px-4" %>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>