<div class="row justify-content-center align-items-center my-5 flex-grow-1">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card purple-card p-4 text-white shadow-lg">
      <h2 class="text-center text-neon-purple fw-bold mb-4">
        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
      </h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-3">
          <%= f.label :email, "E-posta Adresi", class: "form-label fw-semibold text-white-50" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control bg-dark text-white border-secondary", placeholder: "ornek@email.com" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "Şifre", class: "form-label fw-semibold text-white-50" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control bg-dark text-white border-secondary", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-4">
            <%= f.check_box :remember_me, class: "form-check-input bg-dark border-secondary" %>
            <%= f.label :remember_me, "Beni Hatırla", class: "form-check-label text-white-50 small" %>
          </div>
        <% end %>

        <div class="d-grid mb-3">
          <%= f.submit "Sisteme Giriş Yap", class: "btn btn-neon-purple fw-bold py-2" %>
        </div>
      <% end %>

      <div class="text-center mt-3 border-top border-secondary pt-3 small">
        <%= link_to "Şifremi Unuttum", new_password_path(resource_name), class: "text-neon-purple text-decoration-none d-block mb-1" %>
        <span class="text-white-50">Hesabın yok mu?</span> 
        <%= link_to "Kayıt Ol", new_registration_path(resource_name), class: "text-neon-purple fw-bold text-decoration-none" %>
      </div>
    </div>
  </div>
</div>