<div class="container mt-4">
  <h1 class="mb-4 text-white">Kullanıcılar</h1>

  <table class="table table-dark table-hover">
    <thead>
      <tr>
        <th>#</th>
        <th>Ad Soyad</th>
        <th>Kullanıcı Adı</th>
        <th>E-posta</th>
        <th>Rol</th>
        <th>Aktif</th>
        <th>İşlemler</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.fullname %></td>
          <td><%= user.username %></td>
          <td><%= user.email %></td>
          <td><%= user.role %></td>
          <td><%= user.active ? "Evet" : "Hayır" %></td>
          <td>
            <%= link_to "Görüntüle", admin_user_path(user), class: "btn btn-sm btn-info" %>
            <%= link_to "Düzenle", edit_admin_user_path(user), class: "btn btn-sm btn-warning" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>