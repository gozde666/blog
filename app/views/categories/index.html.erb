<div class="container mt-5">
  <h1 class="fw-bold mb-4">Kategoriler</h1>
  
  <div class="mb-4">
    <% @categories.each do |category| %>
      <%= link_to category_path(category), class: "text-decoration-none" do %>
        <span class="badge bg-secondary me-2 fs-6">
          <%= category.name %> (<%= category.posts.count %>)
        </span>
      <% end %>
    <% end %>
  </div>

  <hr>

  <% @categories.each do |category| %>
    <% category.posts.each do |post| %>
      <div class="mb-3">
        <small class="text-muted fw-bold"><%= category.name %></small>
        <h5><%= link_to post.title, post_path(post), class: "text-decoration-none" %></h5>
        <small class="text-muted"><%= post.created_at.strftime("%d %b %Y") %></small>
      </div>
      <hr>
    <% end %>
  <% end %>

  <div class="mt-4">
    <%= link_to "Yeni Kategori Ekle", new_category_path, class: "btn btn-primary" %>
  </div>
</div>
