<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :article, style: "display: block" %>
    <%= form.textarea :article %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.number_field :status %>
  </div>

  <div class="mb-3">
  <%= form.label :category_ids, "Kategoriler", style: "display: block" %>
  <%= form.collection_select :category_ids, Category.all, :id, :name, {}, { multiple: true, class: "form-control" } %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
