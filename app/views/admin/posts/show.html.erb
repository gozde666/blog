<div class="container mt-4">
  <div class="card purple-card p-4 text-white">
    <h1 class="fw-bold"><%= @post.title %></h1>
    <p class="text-muted">Yazar: <%= @post.user.fullname %></p>
    <p class="text-muted">Tarih: <%= @post.created_at.strftime("%d.%m.%Y %H:%M") %></p>
    <hr class="border-light opacity-25">
    <div><%= @post.article %></div>
    <div class="mt-4">
      <%= link_to "Geri Dön", admin_posts_path, class: "btn btn-outline-light rounded-pill px-4" %>
    </div>
  </div>
</div>