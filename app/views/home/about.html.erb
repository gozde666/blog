<div class="row justify-content-center mt-5">
  <div class="col-md-10 col-lg-8">
    <div class="purple-card p-5 shadow-lg text-center border border-purple">
      
      <%# Ders Notu: image_tag kullanımı. Resmini app/assets/images/profile.png olarak kaydetmeyi unutma! %>
      <%= image_tag("profile.png", size: "180x180", class: "rounded-circle border border-purple mb-4 shadow-lg", alt: "Gözde") %>
      
      <h1 class="text-neon-purple fw-bold display-5">Gözde</h1>
      <p class="lead text-white opacity-75 mb-4">
        Bilgisayar Programcılığı 2. sınıf öğrencisiyim.
      </p>

      <hr class="border-light opacity-25">

      <%# Ders Notu: Sosyal medya ikonları ve link_to kullanımı %>
      <div class="mt-4">
        <h5 class="text-neon-purple mb-3 text-uppercase small fw-bold">Bağlantılarım</h5>
        
        <%= link_to "https://github.com/gozde666", target: "_blank", class: "text-white mx-3 fs-1" do %>
          <i class="bi bi-github"></i>
        <% end %>
        
        <%= link_to "https://linkedin.com", target: "_blank", class: "text-info mx-3 fs-1" do %>
          <i class="bi bi-linkedin"></i>
        <% end %>

        <a href="mailto:gozdenurcayir6@gmail.com" class="text-neon-purple mx-3 fs-1">
          <i class="bi bi-envelope-heart"></i>
        </a>
      </div>

    </div>
  </div>
</div>