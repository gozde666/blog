<div class="container mt-4">
  <h1 class="text-white mb-4">Kullanıcı Düzenle</h1>

  <%= form_with model: [:admin, @user], class: "card bg-dark text-white border-secondary p-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="alert alert-danger">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="row mb-3">
      <div class="col">
        <%= f.label :firstname, "Ad", class: "form-label" %>
        <%= f.text_field :firstname, class: "form-control bg-secondary text-white border-0" %>
      </div>
      <div class="col">
        <%= f.label :lastname, "Soyad", class: "form-label" %>
        <%= f.text_field :lastname, class: "form-control bg-secondary text-white border-0" %>
      </div>
    </div>

    <div class="mb-3">
      <%= f.label :username, "Kullanıcı Adı", class: "form-label" %>
      <%= f.text_field :username, class: "form-control bg-secondary text-white border-0" %>
    </div>

    <div class="mb-3">
      <%= f.label :email, "E-posta", class: "form-label" %>
      <%= f.email_field :email, class: "form-control bg-secondary text-white border-0" %>
    </div>

    <div class="mb-3">
      <%= f.label :role, "Rol", class: "form-label" %>
      <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] }, {}, class: "form-select bg-secondary text-white border-0" %>
    </div>

    <div class="mb-3">
      <%= f.label :active, "Aktif", class: "form-label" %>
      <%= f.select :active, [["Evet", true], ["Hayır", false]], {}, class: "form-select bg-secondary text-white border-0" %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "Güncelle", class: "btn btn-success" %>
      <%= link_to "İptal", admin_user_path(@user), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>