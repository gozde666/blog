<!DOCTYPE html>
<html>
  <head>
    <title>Admin Panel</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <style>
      html, body { background-color: #000000 !important; color: #ffffff !important; }
      .purple-card { background-color: #4b0082 !important; border: 1px solid #6a0dad !important; border-radius: 20px; }
      .text-neon-purple { color: #d8b4fe !important; }
      .btn-neon-purple { background-color: #8a2be2 !important; color: white !important; border: none; }
      .navbar { background-color: #111111 !important; border-bottom: 2px solid #8a2be2; }
      footer { background-color: #111111 !important; border-top: 2px solid #8a2be2; }
      .sidebar { background-color: #111111; border-right: 1px solid #8a2be2; min-height: 100%; border-radius: 12px; padding: 20px; }
      .sidebar a { color: #d8b4fe; text-decoration: none; display: block; padding: 8px 12px; border-radius: 8px; }
      .sidebar a:hover, .sidebar a.active { background-color: #4b0082; color: white; }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%= render "shared/navbar" %>
    <div class="container-fluid flex-grow-1 py-3">
      <div class="row g-3">
        <div class="col-12 col-lg-3 col-xl-2">
          <%= render "shared/sidebar" %>
        </div>
        <div class="col-12 col-lg-9 col-xl-10">
          <main class="p-2 p-lg-3"><%= yield %></main>
        </div>
      </div>
    </div>
    <%= render "shared/footer" %>
  </body>
</html>