<div id="<%= dom_id post %>">
  <p>
    <strong>Title:</strong>
    <%= post.title %>
  </p>
  <p>
    <strong>Article:</strong>
    <%= post.article %>
  </p>
  <p>
    <strong>Status:</strong>
    <%= post.status %>
  </p>
  <p>
    <% post.categories.each do |category| %>
      <span class="badge bg-primary"><%= category.name %></span>
    <% end %>
  </p>
</div>
