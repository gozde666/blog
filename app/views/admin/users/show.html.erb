<div class="container mt-4">
  <h1 class="text-white mb-4"><%= @user.fullname %></h1>

  <div class="card bg-dark text-white border-secondary">
    <div class="card-body">
      <p><strong>Kullanıcı Adı:</strong> <%= @user.username %></p>
      <p><strong>E-posta:</strong> <%= @user.email %></p>
      <p><strong>Cinsiyet:</strong> <%= @user.gender %></p>
      <p><strong>Rol:</strong> <%= @user.role %></p>
      <p><strong>Aktif:</strong> <%= @user.active ? "Evet" : "Hayır" %></p>
      <p><strong>Kayıt Tarihi:</strong> <%= @user.created_at.strftime("%d.%m.%Y") %></p>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <%= link_to "Düzenle", edit_admin_user_path(@user), class: "btn btn-warning" %>
    <%= link_to "Geri Dön", admin_users_path, class: "btn btn-secondary" %>
  </div>
</div>