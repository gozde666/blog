<h1>Yazıyı Düzenle</h1>

<%= form_with model: @post, url: "/update/#{@post.id}", method: :patch, local: true do |f| %>
  <%# 'f' değişkenini 'form' ismiyle içeriye gönderiyoruz %>
  <%= render "form", form: f %>
<% end %>

