<div class="sidebar">
  <h5 class="text-neon-purple fw-bold">Admin Panel</h5>
  <p class="text-muted small">Yonetim Menusu</p>
  <hr class="border-light opacity-25">
  <%= link_to admin_users_path, class: "#{controller_name == 'users' && controller.class.module_parent == Admin ? 'active' : ''}" do %>
    <i class="bi bi-people me-2"></i> Tum Kullanicilar
  <% end %>
  <%= link_to admin_posts_path, class: "#{controller_name == 'posts' && controller.class.module_parent == Admin ? 'active' : ''}" do %>
    <i class="bi bi-file-text me-2"></i> Tum Blog Kayitlari
  <% end %>
  <% if current_user %>
    <%= link_to edit_user_profile_path(current_user), class: "" do %>
      <i class="bi bi-person-lines-fill me-2"></i> Profil Guncelle
    <% end %>
  <% end %>
  <%= link_to root_path, class: "" do %>
    <i class="bi bi-house me-2"></i> Siteye Don
  <% end %>
</div>