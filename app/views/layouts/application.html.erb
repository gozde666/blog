<!DOCTYPE html>
<html>
  <head>
    <title>Blogger B Gozde666</title>
    <%# Responsive tasarım için gerekli viewport ayarı %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap İkonları (Hakkımda sayfası için gerekli olacak) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <style>
      /* Senin mevcut Cyberpunk stillerin */
      html, body { 
        background-color: #000000 !important; 
        color: #ffffff !important;
      }

      .purple-card { 
        background-color: #4b0082 !important; 
        border: 1px solid #6a0dad !important;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }

      .text-neon-purple { color: #d8b4fe !important; }
      .btn-neon-purple { 
        background-color: #8a2be2 !important; 
        color: white !important; 
        border: none;
        box-shadow: 0 4px 15px rgba(138, 43, 226, 0.4);
      }

      .btn-light-pink { 
        background-color: #ff99bb !important; 
        color: #000000 !important; 
        border: none;
        font-weight: bold;
      }
      .btn-light-pink:hover { background-color: #ffb3cc !important; }

      .navbar { 
        background-color: #111111 !important; 
        border-bottom: 2px solid #8a2be2; 
      }

      /* Ders notu: Footer'ın hep en altta kalması için ek stil */
      footer {
        background-color: #111111 !important;
        border-top: 2px solid #8a2be2;
      }
    </style>
  </head>

  <%# Ders notu: Footer'ı en alta sabitlemek için 'flex-column' ve 'min-vh-100' ekliyoruz %>
  <body class="d-flex flex-column min-vh-100" style="background-color: #000000 !important;">
    
    <%# Ders notu: Navbar'ı dış dosyadan çağırıyoruz %>
    <%= render "shared/navbar" %>

    <%# Ders notu: 'flex-grow-1' içeriğin boşluğu doldurmasını ve footer'ı aşağı itmesini sağlar[cite: 1] %>
    <div class="container flex-grow-1">
      <%= yield %>
    </div>

    <%# Ders notu: Footer'ı dış dosyadan çağırıyoruz[cite: 1] %>
    <%= render "shared/footer" %>

    <!-- Bootstrap JS[cite: 1] -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>