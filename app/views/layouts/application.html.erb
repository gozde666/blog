<!DOCTYPE html>
<html>
  <head>
    <title>Blogger B Gozde666</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS (CDN - İnternet üzerinden doğrudan yükleme) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style>
      /* Sayfa arka planını tamamen siyah yapar */
      html, body { 
        background-color: #000000 !important; 
        color: #ffffff !important;
        min-height: 100vh;
      }

      /* Kartlar: Mor ve gölgeli */
      .purple-card { 
        background-color: #4b0082 !important; 
        border: 1px solid #6a0dad !important;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }

      /* Yazı Başlıkları ve Neon Mor */
      .text-neon-purple { color: #d8b4fe !important; }
      .btn-neon-purple { 
        background-color: #8a2be2 !important; 
        color: white !important; 
        border: none;
        box-shadow: 0 4px 15px rgba(138, 43, 226, 0.4);
      }

      /* Açık Pembe Silme Butonu */
      .btn-light-pink { 
        background-color: #ff99bb !important; /* Daha açık ve soft pembe */
        color: #000000 !important; /* Okunabilirlik için yazı siyah */
        border: none;
        font-weight: bold;
      }
      .btn-light-pink:hover { background-color: #ffb3cc !important; }

      /* Navbar düzenlemesi */
      .navbar { 
        background-color: #111111 !important; 
        border-bottom: 2px solid #8a2be2; 
      }
    </style>
  </head>

  <body style="background-color: #000000 !important;">
    <nav class="navbar navbar-dark bg-dark mb-4">
      <div class="container">
        <span class="navbar-brand mb-0 h1">Gözde'nin Blogu</span>
      </div>
    </nav>

    <div class="container">
      <%= yield %>
    </div>

    <!-- Bootstrap JS (Opsiyonel: Modal veya Dropdown kullanacaksan) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>