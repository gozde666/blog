<div class="container mt-5">
  <% if @post.image.present? %>
    <div class="mb-4">
      <%= image_tag(@post.image, class: "img-fluid rounded w-100", style: "max-height: 400px; object-fit: cover;") %>
    </div>
  <% end %>

  <div class="card purple-card p-4 text-white">
    <h1 class="fw-bold"><%= @post.title %></h1>
    
    <div class="mb-3">
      <% @post.categories.each do |category| %>
        <span class="badge bg-primary me-1"><%= category.name %></span>
      <% end %>
    </div>

    <p><%= @post.article %></p>

    <div class="d-flex gap-3 mt-4">
      <%= link_to t("actions.edit"), edit_post_path(@post), class: "btn btn-neon-purple rounded-pill px-4" %>
      <%= link_to t("actions.back"), posts_path, class: "btn btn-outline-light rounded-pill px-4" %>
      <%= button_to "Sil", post_path(@post), method: :delete, data: { confirm: "Emin misin?" }, class: "btn btn-danger rounded-pill px-4" %>
    </div>
  </div>
</div>
